# Compose variable defaults for this stack.
# Container-level settings live in docker-compose.yml (environment:), not here.

# Image tags
OLLAMA_DOCKER_TAG=latest
WEBUI_DOCKER_TAG=main

# Host port for the web UI (container port 8080)
OPEN_WEBUI_PORT=3000

# Leave empty to auto-generate on first run (persisted in the open-webui volume)
WEBUI_SECRET_KEY=
