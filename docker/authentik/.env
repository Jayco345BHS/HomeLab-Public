# Authentik Configuration
# IMPORTANT: Change these values before deploying!

# PostgreSQL Database Configuration
PG_USER=authentik
PG_DB=authentik
PG_PASS=CHANGE_ME_secure_database_password_here

# Authentik Secret Key
# Generate a new one with: openssl rand -base64 32
AUTHENTIK_SECRET_KEY=CHANGE_ME_run_openssl_rand_base64_32

# Port Configuration
COMPOSE_PORT_HTTP=9000
COMPOSE_PORT_HTTPS=9443
