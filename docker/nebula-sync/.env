# Nebula Sync Configuration
# IMPORTANT: Update these with your actual Pi-hole URLs and passwords

# Primary Pi-hole (format: http://hostname|password)
PRIMARY=http://ph1.example.com|CHANGE_ME_password

# Replica Pi-holes (format: http://hostname1|password1,http://hostname2|password2)
REPLICAS=http://ph2.example.com|CHANGE_ME_password,http://ph3.example.com|CHANGE_ME_password

# Sync Configuration
FULL_SYNC=true
RUN_GRAVITY=true

# Cron Schedule (every hour)
CRON=0 * * * *
